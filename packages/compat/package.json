{
  "name": "@alicloud/cloud-charts-compat",
  "version": "1.0.0-alpha.4",
  "description": "Compatibility adapter for @alicloud/cloud-charts 3.x APIs. Wraps @alicloud/cloud-charts-react with legacy Wbar/Wline/Wpie names.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "rollup -c rollup.config.mjs",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "peerDependencies": {
    "@alicloud/cloud-charts-core": "1.0.0-alpha.4",
    "@alicloud/cloud-charts-react": "1.0.0-alpha.2",
    "react": ">=17 <20",
    "react-dom": ">=17 <20"
  },
  "devDependencies": {
    "rollup": "^4.22.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-commonjs": "^28.0.0",
    "rollup-plugin-dts": "^6.1.0",
    "tslib": "^2.7.0",
    "typescript": "4.6.4",
    "vitest": "^1.6.0"
  },
  "license": "MIT"
}
