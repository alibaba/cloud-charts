{
  "name": "@alicloud/cloud-charts-cli",
  "version": "1.0.0-alpha.2",
  "description": "shadcn-style source-copy CLI for the cloud-charts (cloud-charts) visualization library. Install chart component source into your project, or add them as npm dependencies.",
  "type": "module",
  "bin": {
    "cloud-charts": "bin/cloud-charts.mjs",
    "oi": "bin/cloud-charts.mjs"
  },
  "files": [
    "bin",
    "src",
    "vendor"
  ],
  "keywords": [
    "cli",
    "chart",
    "cloud-charts",
    "cloud-charts",
    "shadcn",
    "scaffold",
    "g2",
    "antv"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "cloud-charts Team",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "cloud-charts": "node bin/cloud-charts.mjs",
    "build:vendor": "node scripts/build-vendor.mjs",
    "prepublishOnly": "npm run build:vendor"
  }
}
