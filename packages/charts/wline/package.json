{
  "name": "@alicloud/cloud-charts-line",
  "version": "1.0.0-alpha.4",
  "description": "Vanilla JavaScript line/area chart for Angular, Vue, or any non-React projects. Part of cloud-charts visualization library.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "keywords": [
    "chart",
    "line-chart",
    "area-chart",
    "visualization",
    "g2",
    "antv",
    "cloud-charts",
    "angular",
    "vue",
    "vanilla"
  ],
  "homepage": "https://github.com/alibaba/cloud-charts",
  "repository": {
    "type": "git",
    "url": "https://github.com/alibaba/cloud-charts.git",
    "directory": "packages/charts/wline"
  },
  "license": "MIT",
  "author": "cloud-charts Team",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "rollup -c rollup.config.mjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@alicloud/cloud-charts-core": "1.0.0-alpha.4"
  },
  "devDependencies": {
    "rollup": "^4.22.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-commonjs": "^28.0.0",
    "rollup-plugin-dts": "^6.1.0",
    "tslib": "^2.7.0",
    "typescript": "4.6.4",
    "vitest": "^1.6.0"
  }
}